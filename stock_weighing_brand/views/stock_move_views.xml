<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_weighing_brand_view_move_weight_kanban_view" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_weighing.view_move_weight_kanban_view" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_brand" invisible="1" />
            </field>
            <xpath
                expr="//div[button[@t-if='(!single_move_line &amp;&amp; !context.hide_weight_detail_buttons) || context.show_weight_detail_buttons']]"
                position="attributes"
            >
                <attribute name="class">d-flex align-items-center</attribute>
            </xpath>
            <xpath expr="//div[@name='weight_card_footer']" position="inside">
                <t t-if="record.logo.raw_value">
                    <field name="logo" widget="image" options='{"size": [32, 32]}' />
                </t>
                <t t-else="">
                    <span
                        t-if="record.product_brand.raw_value"
                        class="badge badge-dark text-left"
                    >
                        <em>
                            <t t-out="record.product_brand.raw_value" />
                        </em>
                    </span>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
