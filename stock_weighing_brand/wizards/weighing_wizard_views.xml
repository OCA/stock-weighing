<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="weighing_wizard_form_view" model="ir.ui.view">
        <field name="model">weighing.wizard</field>
        <field name="inherit_id" ref="stock_weighing.weighing_wizard_form_view" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="logo" invisible="1" />
                <field name="product_brand" invisible="1" />
            </field>
            <xpath expr="//footer" position="inside">
                <t t-if="record.logo.raw_value" class="text-right">
                    <field name="logo" widget="image" options='{"size": [64, 64]}' />
                </t>
                    <span
                    t-if="record.product_brand.raw_value and not record.logo.raw_value"
                    class="badge badge-info text-left"
                >
                        <t t-out="record.product_brand.raw_value" />
                </span>
            </xpath>
        </field>
    </record>
</odoo>
