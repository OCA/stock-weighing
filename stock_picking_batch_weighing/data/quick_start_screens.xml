<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record
        id="quick_start_screen_action_batch_picking_any_operations"
        model="quick.start.screen.action"
    >
        <field name="name">Batch Picking</field>
        <field name="description">Weighing batch picking</field>
        <field name="domain">[
            ("location_id.usage", "not in", ["internal", "transit"]),
            ("location_dest_id.usage", "in", ["internal", "transit"]),
            ("picking_type_id.weighing_operations", "=", True),
        ]</field>
        <field name="action_ref_id" ref="stock_weighing.weighing_operation_action" />
        <field name="context">{'show_weight_detail_buttons': True}</field>
        <field name="icon_name">fa-truck</field>
        <field name="color">7</field>
    </record>
    <record id="stock_weighing.quick_start_screen_weighing" model="quick.start.screen">
        <field
            name="action_ids"
            eval="[
            (4, ref('stock_picking_batch_weighing.quick_start_screen_action_batch_picking_any_operations'))
        ]"
        />
    </record>
</odoo>
