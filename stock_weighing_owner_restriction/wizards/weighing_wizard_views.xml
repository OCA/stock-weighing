<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="weighing_wizard_form_view" model="ir.ui.view">
        <field name="name">weighing.wizard.form - owner restriction</field>
        <field name="model">weighing.wizard</field>
        <field name="inherit_id" ref="stock_weighing.weighing_wizard_form_view" />
        <field name="arch" type="xml">
            <field name="quant_id" position="before">
                <field name="available_quant_ids" invisible="1" />
            </field>
            <field name="quant_id" position="attributes">
                <attribute name="domain">[('id', 'in', available_quant_ids)]</attribute>
            </field>
        </field>
    </record>
</odoo>
