<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record
        id="quick_start_screen_action_elaborations"
        model="quick.start.screen.action"
    >
        <field name="name">Elaborations</field>
        <field name="description">Outgoing elaborations</field>
        <field name="action_ref_id" ref="stock_weighing.weighing_operation_action" />
        <field name="domain">[
            '|', ('elaboration_note', '!=', ''), ('elaboration_ids', '!=', False)
        ]</field>
        <field name="context">{'show_weight_detail_buttons': True}</field>
        <field name="icon_name">fa-cutlery</field>
        <field name="color">7</field>
    </record>
    <record id="stock_weighing.quick_start_screen_weighing" model="quick.start.screen">
        <field
            name="action_ids"
            eval="[
            (4, ref('sale_elaboration_weighing.quick_start_screen_action_elaborations'))
        ]"
        />
    </record>
</odoo>
