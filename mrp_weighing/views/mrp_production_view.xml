<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="weighing_operations" invisible="1" />
                <field name="has_weighing_operations" invisible="1" />
                <button
                    name="action_weighing_operations"
                    string="Weight"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-thermometer-half "
                    invisible="(not has_weighing_operations) or (state in ['draft', 'cancel'])"
                />
            </div>
            <xpath
                expr="//field[@name='move_raw_ids']//list//field[@name='quantity']"
                position="before"
            >
                <field
                    name="qty_picked"
                    column_invisible="not parent.has_weighing_operations"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
    <record id="mrp_production_kanban" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="has_weighing_operations" invisible="1" />
            </field>
            <xpath expr="//footer" position="inside">
                <button
                    name="action_weighing_operations"
                    type="object"
                    class="btn btn-primary"
                    title="Weighings"
                >
                    <i class="fa fa-thermometer" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
